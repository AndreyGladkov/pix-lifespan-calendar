{
  "name": "lifespan-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Draw your life as a grid of days, weeks or months.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch-who": "tsx scripts/fetch-who.ts"
  },
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "date-fns": "^4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^9",
    "@eslint/json": "0.14.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "i18n-iso-countries": "^7.14.0",
    "obsidian": "1.8.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
